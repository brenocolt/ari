<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  targetNamespace="http://bpmn.io/schema/bpmn"
  id="Definitions_1">

  <process id="Process_1" isExecutable="false">

    <!-- Eventos -->
    <startEvent id="StartEvent_1" name="Início"/>
    <endEvent   id="EndEvent_1"   name="Fim"/>

    <!-- Tarefas -->
    <task id="Task_1" name="Receber Pedido"/>
    <task id="Task_2" name="Processar Pedido"/>
    <task id="Task_3" name="Notificar Cliente"/>

    <!-- Gateway XOR (decisão) -->
    <exclusiveGateway id="Gateway_1" name="Há estoque?" gatewayDirection="Diverging"/>
    <!-- Gateway XOR (junção) -->
    <exclusiveGateway id="Gateway_2" name=""            gatewayDirection="Converging"/>

    <!-- Fluxos do caminho principal -->
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_1"       targetRef="Gateway_1"/>

    <!-- Ramo Sim -->
    <sequenceFlow id="Flow_3" name="Sim" sourceRef="Gateway_1" targetRef="Task_2"/>
    <sequenceFlow id="Flow_5" sourceRef="Task_2"  targetRef="Gateway_2"/>

    <!-- Ramo Não -->
    <sequenceFlow id="Flow_4" name="Não" sourceRef="Gateway_1" targetRef="Task_3"/>
    <sequenceFlow id="Flow_6" sourceRef="Task_3"  targetRef="Gateway_2"/>

    <!-- Fluxo de saída da junção -->
    <sequenceFlow id="Flow_7" sourceRef="Gateway_2" targetRef="EndEvent_1"/>

  </process>

  <!-- ═══════════════════════════════════════════════════════════════
       SEÇÃO DE DIAGRAMA (BPMNDI)
       Todos os elementos precisam de BPMNShape; todos os fluxos
       precisam de BPMNEdge com waypoints, caso contrário o diagrama
       abre em branco no bpmn.io / Camunda Modeler.
  ════════════════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">

      <!-- StartEvent: 36×36, centrado verticalmente em y=200 → y=182 -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="152" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Task_1: 100×80, y=160 (centro em 200) -->
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <omgdc:Bounds x="240" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Gateway_1 (diverging): 50×50, y=175 (centro em 200) -->
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <omgdc:Bounds x="395" y="175" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- Task_2 (ramo Sim, acima): centro em y=120 → y=80 -->
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <omgdc:Bounds x="520" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Task_3 (ramo Não, abaixo): centro em y=280 → y=240 -->
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <omgdc:Bounds x="520" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Gateway_2 (converging): 50×50, y=175 (centro em 200) -->
      <bpmndi:BPMNShape id="Gateway_2_di" bpmnElement="Gateway_2" isMarkerVisible="true">
        <omgdc:Bounds x="680" y="175" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- EndEvent: 36×36, y=182 -->
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="792" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- ── Edges ── -->

      <!-- Flow_1: StartEvent → Task_1
           saída: borda direita do startEvent = (152+36, 182+18) = (188, 200)
           entrada: borda esquerda da task    = (240, 160+40)    = (240, 200) -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="188" y="200"/>
        <omgdi:waypoint x="240" y="200"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_2: Task_1 → Gateway_1
           saída: (240+100, 160+40) = (340, 200)
           entrada: (395, 175+25)   = (395, 200) -->
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="340" y="200"/>
        <omgdi:waypoint x="395" y="200"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_3: Gateway_1 → Task_2 (Sim, vai para CIMA)
           saída: borda superior do gateway = (395+25, 175) = (420, 175)
           dobra horizontal até x=570, desce até y=80+40=120
           entrada: borda esquerda de Task_2 = (520, 80+40) = (520, 120)
           Waypoints: saída topo (420,175) → desce para cima até (420,120) → entra pela esquerda (520,120) -->
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="420" y="175"/>
        <omgdi:waypoint x="420" y="120"/>
        <omgdi:waypoint x="520" y="120"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_4: Gateway_1 → Task_3 (Não, vai para BAIXO)
           saída: borda inferior do gateway = (420, 175+50) = (420, 225)
           desce até y=280, entra pela esquerda de Task_3 (520, 280)
           Waypoints: (420,225) → (420,280) → (520,280) -->
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="420" y="225"/>
        <omgdi:waypoint x="420" y="280"/>
        <omgdi:waypoint x="520" y="280"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_5: Task_2 → Gateway_2 (ramo Sim reconverge)
           saída: (520+100, 80+40)  = (620, 120)
           entrada topo: (680+25, 175) = (705, 175)
           Waypoints: (620,120) → (705,120) → (705,175) -->
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="620" y="120"/>
        <omgdi:waypoint x="705" y="120"/>
        <omgdi:waypoint x="705" y="175"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_6: Task_3 → Gateway_2 (ramo Não reconverge)
           saída: (520+100, 240+40) = (620, 280)
           entrada base: (705, 225)
           Waypoints: (620,280) → (705,280) → (705,225) -->
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="620" y="280"/>
        <omgdi:waypoint x="705" y="280"/>
        <omgdi:waypoint x="705" y="225"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_7: Gateway_2 → EndEvent
           saída: (680+50, 175+25) = (730, 200)
           entrada: (792, 182+18)  = (792, 200) -->
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <omgdi:waypoint x="730" y="200"/>
        <omgdi:waypoint x="792" y="200"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
