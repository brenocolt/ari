# Copie este arquivo para .env e preencha com a sua chave da Anthropic.
# Nunca faça commit do arquivo .env nem exponha esta chave no navegador.
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Opcional: troque o modelo (padrão: claude-opus-5-5)
# ARI_MODEL=claude-sonnet-5-5

# Opcional: porta do servidor (padrão: 3000)
# PORT=3000

# Opcional: autoria e periodicidade de revisão impressas no POP
# ARI_EMPRESA=Produtiva Junior
# ARI_REVISAO=Trimestral

# Opcional: mapeamentos BPMN com modelo escolhido pelo Jev (TypeSafe, jev-latest)
# conforme a complexidade do processo. Sem a chave, usa ARI_MODEL.
# TYPESAFE_API_KEY=sua-chave-typesafe
# ARI_MODEL_SIMPLES=claude-haiku-5-5
# ARI_MODEL_MEDIO=claude-sonnet-5-5
# ARI_MODEL_COMPLEXO=claude-opus-5-5
