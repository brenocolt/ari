# Copie este arquivo para .env e preencha com a sua chave da Anthropic.
# Nunca faça commit do arquivo .env nem exponha esta chave no navegador.
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Opcional: troque o modelo (padrão: claude-opus-4-8)
# ARI_MODEL=claude-sonnet-4-6

# Opcional: porta do servidor (padrão: 3000)
# PORT=3000
